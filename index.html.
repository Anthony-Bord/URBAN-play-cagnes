    <!-- Polices -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        charcoal: '#111111',
                        offwhite: '#F5F5F0',
                        electric: '#C6FF00',
                        urbangray: '#777777'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Montserrat', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        body { background-color: #111111; color: #F5F5F0; }
        .font-heading { font-family: 'Montserrat', sans-serif; text-transform: uppercase; }
        .section-page { display: none; animation: fadeIn 0.4s ease-in-out; }
        .section-page.active { display: block; }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .bg-hero {
            background-image: linear-gradient(rgba(17, 17, 17, 0.6), rgba(17, 17, 17, 0.9)), url('https://images.unsplash.com/photo-1518605368461-1e1e38ce81ba?auto=format&fit=crop&w=1950&q=80');
            background-size: cover;
            background-position: center;
        }

        /* Styles de la carte 3D interactive des terrains */
        .pitch-scene {
            perspective: 1100px;
            padding: 2.5rem 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1.75rem;
            flex-wrap: wrap;
        }

        .pitch-3d {
            width: 130px;
            height: 205px;
            position: relative;
            transform: rotateX(50deg) rotateZ(-30deg);
            transform-style: preserve-3d;
            border-radius: 8px;
            border: 2px solid rgba(255,255,255,0.85);
            box-shadow: -8px 14px 18px rgba(0,0,0,0.6);
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-family: 'Montserrat', sans-serif;
            font-weight: 900;
            user-select: none;
        }

        /* Marquages au sol du terrain */
        .pitch-3d::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 2px;
            background: rgba(255,255,255,0.75);
            transform: translateY(-50%);
            pointer-events: none;
        }
        .pitch-3d::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 36px;
            height: 36px;
            border: 2px solid rgba(255,255,255,0.75);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
        }

        /* Terrain disponible (Vert électrique) */
        .pitch-available {
            background: linear-gradient(135deg, #9ed600, #C6FF00);
            color: #111111;
            cursor: pointer;
        }
        .pitch-available:hover {
            transform: rotateX(50deg) rotateZ(-30deg) translateZ(16px);
            box-shadow: -16px 24px 28px rgba(198, 255, 0, 0.3);
            border-color: #111111;
        }

        /* Terrain utilisé / réservé (Rouge) */
        .pitch-occupied {
            background: linear-gradient(135deg, #991b1b, #ef4444);
            color: #F5F5F0;
            cursor: not-allowed;
            opacity: 0.85;
        }

        /* Terrain sélectionné par l'utilisateur */
        .pitch-selected {
            border: 4px solid #ffffff !important;
            transform: rotateX(50deg) rotateZ(-30deg) translateZ(22px) !important;
            box-shadow: -18px 28px 36px rgba(198, 255, 0, 0.5) !important;
        }

        .pitch-text {
            z-index: 10;
            transform: rotateZ(30deg);
            text-align: center;
            pointer-events: none;
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #111111; }
        ::-webkit-scrollbar-thumb { background: #C6FF00; border-radius: 4px; }
    </style>
</head>
