    <div id="custom-modal" class="fixed inset-0 bg-black/80 z-50 hidden flex justify-center items-center p-4">
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 md:p-8 max-w-md w-full">
            <h3 id="modal-title" class="font-heading text-2xl text-electric mb-3">Titre</h3>
            <p id="modal-text" class="text-gray-300 mb-6 text-sm"></p>
            <button onclick="closeModal()" class="w-full bg-electric text-charcoal font-heading py-3 rounded font-bold hover:bg-white transition-colors">COMPRIS</button>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-[#0a0a0a] border-t border-gray-900 py-12 text-center text-gray-500 text-sm">
        <div class="font-heading text-2xl font-black tracking-tighter text-gray-700 mb-4">URBAN<span class="text-gray-500">PLAY</span></div>
        <p class="italic text-xs text-gray-600 mb-4">Prototype non commercial.</p>
    </footer>

    <!-- LOGIQUE JAVASCRIPT -->
    <script>
        let selectedPitch = null;
        // Simulation dynamique des disponibilités selon l'heure choisie (true = disponible, false = utilisé)
        const pitchAvailabilityByTime = {
            "":       { 1: true,  2: false, 3: true,  4: false },
            "18:00":  { 1: true,  2: true,  3: false, 4: true  },
            "19:00":  { 1: false, 2: true,  3: true,  4: false },
            "20:00":  { 1: true,  2: false, 3: false, 4: true  },
            "21:00":  { 1: true,  2: true,  3: true,  4: false }
        };

        function navigate(pageId) {
            document.querySelectorAll('.section-page').forEach(el => el.classList.remove('active'));
            document.getElementById(pageId).classList.add('active');
            window.scrollTo(0, 0);
        }

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        function onSlotChange() {
            const time = document.getElementById('res-time').value;
            const statusMap = pitchAvailabilityByTime[time] || pitchAvailabilityByTime[""];

            for (let i = 1; i <= 4; i++) {
                const pitchEl = document.getElementById(`pitch-${i}`);
                const labelEl = pitchEl.querySelector('.status-label');
                const isAvailable = statusMap[i];

                pitchEl.classList.remove('pitch-available', 'pitch-occupied', 'pitch-selected');
                if (isAvailable) {
                    pitchEl.classList.add('pitch-available');
                    labelEl.innerText = 'Libre';
                } else {
                    pitchEl.classList.add('pitch-occupied');
                    labelEl.innerText = 'Occupé';
                    if (selectedPitch === i) {
                        selectedPitch = null;
                    }
                }
            }

            if (selectedPitch) {
                document.getElementById(`pitch-${selectedPitch}`).classList.add('pitch-selected');
            }

            updateRecap();
        }

        function selectPitch(pitchNum) {
            const pitchEl = document.getElementById(`pitch-${pitchNum}`);
            if (pitchEl.classList.contains('pitch-occupied')) {
                openModal('Terrain occupé', `Le Terrain ${pitchNum} est déjà utilisé sur ce créneau. Choisis un terrain affiché en vert.`);
                return;
            }

            document.querySelectorAll('.pitch-3d').forEach(el => el.classList.remove('pitch-selected'));
            pitchEl.classList.add('pitch-selected');
            selectedPitch = pitchNum;
            updateRecap();
        }

        function updateRecap() {
            const date = document.getElementById('res-date').value;
            const time = document.getElementById('res-time').value;
            const duration = parseFloat(document.getElementById('res-duration').value);
            const players = document.getElementById('res-players').value;
            const type = document.getElementById('res-type');
            
            document.getElementById('recap-date').innerText = date ? new Date(date).toLocaleDateString('fr-FR') : '-';
            document.getElementById('recap-time').innerText = time || '-';
            document.getElementById('recap-pitch').innerText = selectedPitch ? `Terrain ${selectedPitch}` : 'Non sélectionné';
            document.getElementById('recap-duration').innerText = duration === 1 ? '1 heure' : duration === 1.5 ? '1 h 30' : '2 heures';
            document.getElementById('recap-players').innerText = players;
            document.getElementById('recap-type').innerText = type.options[type.selectedIndex].text;

            const basePrice = 80;
            document.getElementById('total-price').innerText = basePrice * duration;
        }

        function confirmReservation() {
            const date = document.getElementById('res-date').value;
            const time = document.getElementById('res-time').value;
            if (!date || !time) {
                openModal('Attention', 'Veuillez sélectionner une date et une heure pour continuer.');
                return;
            }
            if (!selectedPitch) {
                openModal('Terrain requis', 'Clique sur l’un des terrains disponibles en vert sur le plan 3D avant de continuer.');
                return;
            }
            openModal('Réservation en cours', `Simulation validée pour le Terrain ${selectedPitch}, le ${new Date(date).toLocaleDateString('fr-FR')} à ${time}. Aucun paiement réel n'est connecté sur ce prototype.`);
        }

        function openModal(title, text) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-text').innerText = text;
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
        }

        function toggleFaq(btn) {
            const content = btn.nextElementSibling;
            const symbol = btn.querySelector('span');
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                symbol.innerText = '-';
            } else {
                content.classList.add('hidden');
                symbol.innerText = '+';
            }
        }

        // Empêcher la sélection de dates passées
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('res-date').setAttribute('min', today);
    </script>
</body>
</html>
